{
  "name": "@scanova/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Scanova worker: key rotation, OCR, trash and user purge, key garbage collection (NestJS standalone).",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@scanova/config": "workspace:*",
    "@scanova/contracts": "workspace:*",
    "@scanova/crypto": "workspace:*",
    "@scanova/database": "workspace:*",
    "@scanova/jobs": "workspace:*",
    "@scanova/keyring": "workspace:*",
    "@scanova/kms": "workspace:*",
    "@scanova/storage": "workspace:*",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@scanova/tooling": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@scanova/keystore": "workspace:*"
  }
}
