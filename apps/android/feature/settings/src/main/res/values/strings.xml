    <string name="feature_settings_sessions_section_this">This phone</string>
    <string name="feature_settings_sessions_section_others">Other devices</string>
    <string name="feature_settings_sessions_this_device">This device</string>
    <string name="feature_settings_sessions_unknown_device">Unknown device</string>
    <string name="feature_settings_sessions_none_other">No other devices are signed in</string>
