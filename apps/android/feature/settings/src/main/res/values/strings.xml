    <string name="feature_settings_server_use_other_body">For people who run their own Scanova server.</string>
    <string name="feature_settings_server_use_builtin">Use the built-in server</string>
    <string name="feature_settings_server_use_builtin_body">Switch back to Scanova\'s own server. Documents on this phone are kept.</string>
    <string name="feature_settings_server_use_builtin_title">Use the built-in server?</string>
    <string name="feature_settings_server_use_builtin_dialog">Scanova will connect to its own server again. Documents on this phone are kept. You can choose your own server here again at any time.</string>
    <string name="feature_settings_server_use_builtin_confirm">Use built-in server</string>
    <string name="feature_settings_server_locked">To use a different server, sign out first. Your documents stay in your account.</string>

    <!-- About -->
    <string name="feature_settings_section_about">About</string>
    <string name="feature_settings_version">Version</string>
    <string name="feature_settings_check_updates">Check for updates</string>

    <!-- Sign out -->
    <string name="feature_settings_sign_out">Sign out</string>
    <string name="feature_settings_sign_out_title">Sign out of this phone?</string>
    <string name="feature_settings_sign_out_body">Your documents stay in your account and are removed from this phone. They come back when you sign in again.</string>
    <plurals name="feature_settings_sign_out_pending_warning">
        <item quantity="one">%1$d document has not been backed up yet and will be lost.</item>
        <item quantity="other">%1$d documents have not been backed up yet and will be lost.</item>
    </plurals>
    <string name="feature_settings_sign_out_confirm">Sign out</string>

    <!-- Signed-in devices -->
    <string name="feature_settings_sessions_title">Signed-in devices</string>
