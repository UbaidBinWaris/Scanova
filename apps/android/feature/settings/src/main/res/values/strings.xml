    <string name="feature_settings_section_backup">Backup</string>
    <string name="feature_settings_backup_up_to_date">Everything is backed up</string>
    <plurals name="feature_settings_backup_waiting">
        <item quantity="one">%1$d document waiting to back up</item>
        <item quantity="other">%1$d documents waiting to back up</item>
    </plurals>
    <!-- %1$s is a relative time such as "5 minutes ago", already translated by Android. -->
    <string name="feature_settings_backup_last">Last backup %1$s</string>
    <string name="feature_settings_backup_last_just_now">Last backup a moment ago</string>
    <string name="feature_settings_backup_never">No backup has finished yet</string>
    <string name="feature_settings_backup_now">Back up now</string>
    <string name="feature_settings_backup_started">Backup started.</string>

    <!-- Security -->
    <string name="feature_settings_section_security">Security</string>
    <string name="feature_settings_app_lock_title">App lock</string>
    <string name="feature_settings_app_lock_body">Ask for your fingerprint, face or screen lock each time Scanova is opened.</string>
    <string name="feature_settings_app_lock_unavailable">Set up a screen lock on this phone first to use the app lock.</string>
    <string name="feature_settings_app_lock_confirm_title">Turn on app lock</string>

    <!-- Server -->
    <string name="feature_settings_section_server">Server</string>
    <string name="feature_settings_server_builtin_title">Built-in server</string>
    <string name="feature_settings_server_custom_title">Your own server</string>
    <string name="feature_settings_server_pinned_badge">Pinned</string>
    <string name="feature_settings_server_public_badge">Public certificate</string>
    <string name="feature_settings_server_version_label">Server version</string>
    <string name="feature_settings_server_fingerprint_label">Certificate fingerprint</string>
    <string name="feature_settings_server_public_certificate">Publicly trusted certificate</string>
