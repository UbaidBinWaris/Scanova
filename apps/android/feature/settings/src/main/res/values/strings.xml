    <string name="feature_settings_sessions_last_used">Last used %1$s</string>
    <!-- %1$s is a device name. Read by screen readers for the sign-out button. -->
    <string name="feature_settings_sessions_sign_out_device">Sign out %1$s</string>
    <!-- %1$s is a device name. -->
    <string name="feature_settings_sessions_revoke_title">Sign out %1$s?</string>
    <string name="feature_settings_sessions_revoke_body">That device will need to sign in again before it can see your documents.</string>
    <string name="feature_settings_sessions_revoke_confirm">Sign out</string>
    <string name="feature_settings_sessions_empty_title">No devices found</string>
    <string name="feature_settings_sessions_empty_body">The list of signed-in devices came back empty. Try loading it again.</string>

    <!-- App lock screen -->
    <string name="feature_settings_lock_title">Scanova is locked</string>
    <string name="feature_settings_lock_body">Unlock to see your documents.</string>
    <string name="feature_settings_lock_unlock">Unlock</string>
    <string name="feature_settings_lock_prompt_title">Unlock Scanova</string>
