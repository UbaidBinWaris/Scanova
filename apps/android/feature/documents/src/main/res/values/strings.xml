    <string name="feature_documents_files_title">Files</string>
    <plurals name="feature_documents_files_count">
        <item quantity="one">%1$d document</item>
        <item quantity="other">%1$d documents</item>
    </plurals>
    <!-- Read by screen readers for the sort button. %1$s is the current order, such as "Newest first". -->
    <string name="feature_documents_sort_description">Sort order: %1$s</string>
    <string name="feature_documents_sort_newest">Newest first</string>
    <string name="feature_documents_sort_oldest">Oldest first</string>
