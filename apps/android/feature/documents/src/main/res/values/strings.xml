    <string name="feature_documents_rename_label">Title</string>
    <string name="feature_documents_rename_required">Enter a title.</string>
    <string name="feature_documents_tags_title">Tags</string>
    <string name="feature_documents_tags_label">Tags, separated by commas</string>
    <string name="feature_documents_tags_hint">For example: tax, 2026, insurance</string>
    <string name="feature_documents_delete_title">Delete this document?</string>
    <plurals name="feature_documents_delete_body_local">
        <item quantity="one">It is removed from this phone. This cannot be undone.</item>
        <item quantity="other">They are removed from this phone. This cannot be undone.</item>
    </plurals>
    <plurals name="feature_documents_delete_body_backup">
        <item quantity="one">It is removed from this phone now, and from your backup as soon as the phone is online. Your account keeps it in the trash for a limited time.</item>
        <item quantity="other">They are removed from this phone now, and from your backup as soon as the phone is online. Your account keeps them in the trash for a limited time.</item>
