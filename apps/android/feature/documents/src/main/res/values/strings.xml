    <plurals name="feature_documents_search_count">
        <item quantity="one">%1$d document found</item>
        <item quantity="other">%1$d documents found</item>
    </plurals>

    <!-- Quick actions on Home. Short: they sit under an icon, four to a row. -->
    <string name="feature_documents_action_scan">Scan</string>
