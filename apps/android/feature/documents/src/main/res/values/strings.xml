    <string name="feature_documents_action_split_pdf">Split PDF</string>
    <string name="feature_documents_action_all_tools">All tools</string>

    <!-- The backup chip at the top of Home. Short: it shares a line with the app\'s name. -->
    <string name="feature_documents_chip_back_up">Back up</string>
    <!-- Signed in, nothing waiting, but no complete backup recorded yet. -->
    <string name="feature_documents_chip_backup_on">Backup on</string>
    <string name="feature_documents_chip_backed_up_now">Backed up · just now</string>
    <!-- %1$s is a short relative time from the system, such as "5 min. ago". -->
    <string name="feature_documents_chip_backed_up_ago">Backed up · %1$s</string>
    <plurals name="feature_documents_chip_backing_up">
        <item quantity="one">Backing up %1$d</item>
        <item quantity="other">Backing up %1$d</item>
    </plurals>
    <plurals name="feature_documents_chip_offline">
        <item quantity="one">Offline · %1$d waiting</item>
        <item quantity="other">Offline · %1$d waiting</item>
    </plurals>
    <plurals name="feature_documents_chip_failed">
        <item quantity="one">%1$d not backed up</item>
        <item quantity="other">%1$d not backed up</item>
    </plurals>

