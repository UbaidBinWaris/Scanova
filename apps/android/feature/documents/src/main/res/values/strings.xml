    <string name="feature_documents_sort_size">Largest first</string>
    <string name="feature_documents_show_grid">Show as grid</string>
    <string name="feature_documents_show_list">Show as list</string>

    <!-- Selecting several documents (long press in Files) -->
    <plurals name="feature_documents_selected_count">
        <item quantity="one">%1$d selected</item>
        <item quantity="other">%1$d selected</item>
    </plurals>
    <string name="feature_documents_select_action">Select</string>
    <string name="feature_documents_selected">Selected</string>
    <string name="feature_documents_not_selected">Not selected</string>
    <string name="feature_documents_selection_close">Cancel selection</string>
