    <!-- %1$s is a date, %2$s the page count phrase, %3$s a file size such as "1.2 MB". -->
    <string name="feature_documents_viewer_details">%1$s · %2$s · %3$s</string>
    <!-- The four actions at the bottom of the viewer. Short: four share one row. -->
    <string name="feature_documents_edit">Edit</string>
    <string name="feature_documents_share">Share</string>
    <string name="feature_documents_text">Text</string>
    <string name="feature_documents_more">More</string>
