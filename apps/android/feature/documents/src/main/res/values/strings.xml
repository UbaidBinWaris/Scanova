    <string name="feature_documents_deselect_all">Deselect all</string>
    <plurals name="feature_documents_delete_many_title">
        <item quantity="one">Delete %1$d document?</item>
        <item quantity="other">Delete %1$d documents?</item>
    </plurals>
    <plurals name="feature_documents_delete_failed">
        <item quantity="one">%1$d document could not be deleted. Try again.</item>
        <item quantity="other">%1$d documents could not be deleted. Try again.</item>
    </plurals>

    <!-- Search and lists, shared by Home and Files -->
    <string name="feature_documents_search_label">Search documents</string>
    <string name="feature_documents_search_close">Close search</string>
    <string name="feature_documents_search_clear">Clear search</string>
    <!-- The first button in an empty library. -->
    <string name="feature_documents_scan_first">Scan a document</string>
    <string name="feature_documents_loading">Loading documents</string>
    <string name="feature_documents_empty_title">No documents yet</string>
    <string name="feature_documents_empty_body_local">Scan a letter, a receipt or a contract, or import photos. Your documents stay on this phone, encrypted, and are backed up once you sign in.</string>
    <string name="feature_documents_empty_body_backup">Scan a letter, a receipt or a contract, or import photos. Each one is encrypted on this phone and backed up to your account automatically.</string>
    <string name="feature_documents_no_results_title">Nothing found</string>
    <string name="feature_documents_no_results_body">No document contains all of these words. Try fewer or different words.</string>
    <plurals name="feature_documents_page_count">
        <item quantity="one">%1$d page</item>
        <item quantity="other">%1$d pages</item>
    </plurals>
    <!-- %1$s is a date, %2$s is the page count phrase above. -->
    <string name="feature_documents_item_details">%1$s · %2$s</string>

