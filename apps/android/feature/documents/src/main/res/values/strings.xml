    <string name="feature_documents_sync_local">Not backed up yet</string>
    <string name="feature_documents_sync_uploading">Backing up</string>
    <string name="feature_documents_sync_synced">Backed up</string>
    <string name="feature_documents_sync_changes_pending">Changes not backed up yet</string>
