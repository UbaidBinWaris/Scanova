    <path
        android:pathData="M31,42V37a6,6 0,0 1,6 -6h5M66,31h5a6,6 0,0 1,6 6v5M77,66v5a6,6 0,0 1,-6 6h-5M42,77h-5a6,6 0,0 1,-6 -6v-5"
        android:strokeWidth="4"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- Page -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M44,36H58L67,45V69A3,3 0,0 1,64 72H44A3,3 0,0 1,41 69V39A3,3 0,0 1,44 36Z" />
    <!-- Folded corner -->
    <path
        android:fillColor="@color/launcher_fold"
        android:pathData="M58,36V42A3,3 0,0 0,61 45H67Z" />
    <!-- Lines of text -->
    <path
        android:pathData="M47,52H61M47,58H61M47,64H55"
        android:strokeWidth="3"
        android:strokeColor="@color/launcher_background"
        android:strokeLineCap="round" />
</vector>
