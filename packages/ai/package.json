{
  "name": "@scanova/ai",
  "version": "0.1.0",
  "private": true,
  "description": "Provider-neutral AI client (OpenAI-compatible chat with JSON-schema output validated by Zod, and embeddings). Never logs prompts or document text.",
  "type": "module",
  "exports": {
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./embedding": {
      "types": "./dist/embedding.d.ts",
      "default": "./dist/embedding.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@scanova/config": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@scanova/tooling": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
