.env
.env.*
!.env.example
infra/.state/
*.pem
*.key
*.p12
*.jks
*.keystore

# ── Node / TypeScript ─────────────────────────────────────────────────
node_modules/
dist/
build/
.turbo/
coverage/
*.tsbuildinfo
.eslintcache
npm-debug.log*
pnpm-debug.log*

# Prisma generated client
**/generated/prisma/

# ── Android ───────────────────────────────────────────────────────────
apps/android/.gradle/
apps/android/.kotlin/
apps/android/local.properties
apps/android/.idea/
apps/android/captures/
