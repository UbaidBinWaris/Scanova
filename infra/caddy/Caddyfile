# Scanova edge — the only service that publishes a port (docs/ARCHITECTURE.md §2, §12).
#
# API host (SCANOVA_PUBLIC_URL):
#   /api/v1/*                    → api:3000
#   /.well-known/scanova/ca.crt  → internal CA certificate (pairing)
#   /internal/*                  → 404, never proxied
#   /app, /_next/static/*        → web:3000, member portal (internal and acme modes only)
#   everything else              → 404
# Site host (public mode):  /app, /_next/static/* → web:3000; the rest is the
#                           static download page and /downloads/android/*.
# Admin host (public mode): /, /admin, /_next/static/*, /favicon.svg → web:3000
#                           (admin console), optionally only from
#                           SCANOVA_ADMIN_ALLOWED_IPS; everything else → 404.
#
# {$VAR} placeholders are substituted from the container environment before
# parsing; infra/compose.yaml passes exactly the ones used here.
{
	admin off
	persist_config off

	# The container listens on the same port number Compose publishes.
	https_port {$SCANOVA_HTTPS_PORT}
	http_port 8080

	servers {
		# HTTP/3 needs a published UDP port, which this stack does not open.
		protocols h1 h2
		timeouts {
			read_header 15s
			idle 2m
		}
		# Mode-specific listener settings (public: PROXY protocol from HAProxy).
		import tls/{$SCANOVA_TLS_MODE}.servers
	}

	log {
		output stderr
		format json
	}

	# Certificate source: tls/internal.global or tls/acme.global.
	import tls/{$SCANOVA_TLS_MODE}.global
}

# Published Android builds (infra/deploy/publish-apk.sh writes them).
# Only plain file names directly under /downloads/android/ are served.
(scanova_downloads) {
	@downloads expression `{http.request.orig_uri.path}.matches('^/downloads/android/[A-Za-z0-9][A-Za-z0-9._-]*$')`
	handle @downloads {
		root * /srv
		@json path *.json
		header @json Cache-Control "no-cache"
		@apk path *.apk
		header @apk Content-Type "application/vnd.android.package-archive"
		header @apk Cache-Control "public, max-age=300"
		file_server
	}
}

# The web app (apps/web). It sends its own nonce-based Content-Security-Policy
# and security headers; the site blocks only add HSTS and set the shared ones
# (deferred, so they replace rather than duplicate what the app sent).
(scanova_web) {
	request_body {
		# Server actions are small JSON; nothing is uploaded through the web app.
		max_size 1MB
	}
	reverse_proxy web:3000 {
		# The service token may only ever originate from the web app itself.
		header_up -X-Scanova-Service-Token
		header_down -X-Powered-By
	}
}

(scanova_routes) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}

	# `route` keeps the written order. First match wins.
	route {
		# 1. The internal API is for the web app on the private network only.
		#    Path matching is case-insensitive and runs on the cleaned path, so
		#    /api/v1/../../internal/x is caught here as well.
		@internal path /internal /internal/*
		respond @internal 404

		# 2. Pairing: the phone downloads the CA certificate and checks its
		#    SHA-256 against the fingerprint from the bootstrap QR code.
		handle /.well-known/scanova/ca.crt {
			root * /etc/scanova/pki
			rewrite * /ca.crt
			header Content-Type application/x-pem-file
			header Cache-Control "no-store"
			file_server
		}

		# 3. Client API. Only a plain request line is forwarded: the raw path
		#    must be /api/v1 followed by [A-Za-z0-9_-] segments. That rejects
		#    dot segments, doubled slashes, percent-encoding, backslashes and
		#    matrix parameters, so the edge and the API can never disagree
		#    about which route a request addresses. A new API path that needs
		#    other characters must be allowed here deliberately.
		@api expression `{http.request.orig_uri}.matches('^/api/v1(/[A-Za-z0-9_-]+)*/?([?].*)?$')`
		handle @api {
			request_body {
				max_size {$MAX_UPLOAD_BYTES}
			}
			# The readiness probe touches every data service; it is for the
			# container network only, never for the internet.
			respond /api/v1/health/ready 404
			reverse_proxy api:3000 {
				# The service token may only ever originate from the web app.
				header_up -X-Scanova-Service-Token
			}
		}

		# 4. Published Android builds: the in-app updater asks the server it is
		#    paired with, so the app never talks to another host.
		import scanova_downloads

		# 5. The member portal, in the modes with a single host (tls/<mode>.portal).
		import tls/{$SCANOVA_TLS_MODE}.portal

		# 6. Everything else.
		respond 404
	}
}

# Container-local health endpoint for the Compose healthcheck. Bound to
# loopback inside the container and never published.
http://127.0.0.1:8081 {
	bind 127.0.0.1
	respond /healthz 200
	respond 404
}

# public mode: the download site (SCANOVA_SITE_HOST) and the member portal.
(scanova_site) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		?Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Static pages only (`?` = when the response has none): the web app
		# sends its own policy with a fresh nonce, which must not be replaced.
		?Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		-Server
	}
	route {
		@internal path /internal /internal/*
		respond @internal 404
		# The member portal (web app) and its build assets.
		@portal path /app /app/* /_next/static/*
		handle @portal {
			import scanova_web
		}
		import scanova_downloads
		root * /srv/site/public
		try_files {path} {path}/index.html
		file_server
	}
	handle_errors 404 {
		root * /srv/site/public
		rewrite * /404.html
		file_server
	}
}

# public mode: the admin host, served by the web app's admin console only.
(scanova_admin) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		X-Robots-Tag "noindex, nofollow"
		?Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# The console sends its own nonce-based policy; this one covers the rest.
		?Content-Security-Policy "default-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		-Server
	}
	# Optional network allow-list (default: everyone). With the PROXY protocol
	# from HAProxy, remote_ip is the client's real address.
	@outside not remote_ip {$SCANOVA_ADMIN_ALLOWED_IPS:0.0.0.0/0 ::/0}
	route {
		respond @outside 404
		@internal path /internal /internal/*
		respond @internal 404
		respond /robots.txt <<TXT
			User-agent: *
			Disallow: /
			TXT 200
		# /, /admin/* and the console's build assets; nothing else exists here.
		@console path / /admin /admin/* /_next/static/* /favicon.svg
		handle @console {
			import scanova_web
		}
		respond 404
	}
}

# The public site: tls/internal.site, tls/acme.site or tls/public.site.
import tls/{$SCANOVA_TLS_MODE}.site
