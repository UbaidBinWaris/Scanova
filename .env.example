# ══════════════════════════════════════════════════════════════════════
#  Scanova — the ONE environment file for the whole system.
#
#  Copy to `.env` (git-ignored) or run `infra/scripts/bootstrap.sh`, which
#  creates `.env` from this template and fills every value marked
#  <generated>. There are no per-app .env files anywhere in the repo.
#
#  Who reads it:
#    • Docker Compose  → interpolates ${VAR} and passes each container only
#                        the variables it needs (never the whole file).
#    • Node apps/tools → through @scanova/config, which validates with Zod
#                        and fails fast with a descriptive error.
#
#  Addresses below are HOST-SIDE (for running apps, migrations and tests on
#  the machine itself). Inside the Compose network the service names are
#  pinned in infra/compose.yaml (postgres, garage, openbao).
# ══════════════════════════════════════════════════════════════════════

# ── General ───────────────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info

# ── Edge / TLS (Caddy) ────────────────────────────────────────────────
# URL the phone uses to reach the server, and every host/IP that must
# appear in the edge certificate (10.0.2.2 = Android emulator → host).
SCANOVA_PUBLIC_URL=https://192.168.1.100:8443
SCANOVA_PUBLIC_HOSTS=192.168.1.100,localhost,127.0.0.1,10.0.2.2
SCANOVA_HTTPS_PORT=8443
# internal = certificates from Scanova's own CA (LAN / VPN)
# acme     = public certificate for the one host in SCANOVA_PUBLIC_URL
# public   = public certificates for the API host plus the download site and
#            the admin host below, behind a TCP proxy that speaks the PROXY
#            protocol (see infra/deploy/README.md)
SCANOVA_TLS_MODE=internal
SCANOVA_ACME_EMAIL=
# public mode: host names of the download site and the admin console.
SCANOVA_SITE_HOST=
SCANOVA_ADMIN_HOST=
# public mode: client networks that may open the admin host (CIDRs, space-
# separated), e.g. "192.168.1.0/24 203.0.113.7/32". Everyone else gets a 404.
SCANOVA_ADMIN_ALLOWED_IPS="0.0.0.0/0 ::/0"
# Address the edge publishes on: 0.0.0.0 = every interface; 127.0.0.1 when a
# proxy on the same machine forwards to it.
SCANOVA_BIND_ADDRESS=0.0.0.0
# Tag of the api/worker/migrate/web images. Deploys set it to the release id.
SCANOVA_IMAGE_TAG=local
# Internal CA certificate (created by bootstrap); trusted by api/worker
# for PostgreSQL and OpenBao, and pinned by the phone during pairing.
SCANOVA_CA_CERT_PATH=./infra/.state/pki/ca.crt

# ── API (NestJS) ──────────────────────────────────────────────────────
API_PORT=3000
MAX_UPLOAD_BYTES=104857600
USER_DEFAULT_QUOTA_BYTES=10737418240
TRASH_RETENTION_DAYS=30
# Proves a caller of /internal/* is the Next.js web app. <generated>
WEB_SERVICE_TOKEN=

# ── Web app (Next.js: member portal + admin console) ──────────────────
# Encrypts the browser's session cookie (AES-256-GCM). Changing it signs
# everyone out of the web app; phones are not affected. <generated>
WEB_COOKIE_SECRET=
# Host-side address of the API, for running the web app on this machine
# (`pnpm --filter @scanova/web dev`). Compose pins http://api:3000.
WEB_API_URL=http://127.0.0.1:3000
# Development only: the origins the browser uses, e.g. http://localhost:3001
# and http://admin.localhost:3001. Leave empty on a server: the member portal
# is then on SCANOVA_SITE_HOST and the console on SCANOVA_ADMIN_HOST (public
# mode), or the portal on SCANOVA_PUBLIC_URL and no console (other modes).
WEB_SITE_ORIGIN=
WEB_ADMIN_ORIGIN=

# ── Auth ──────────────────────────────────────────────────────────────
JWT_ISSUER=scanova
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_DAYS=30
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1
LOGIN_MAX_ATTEMPTS_PER_MINUTE=5
# Open sign-up from the app: anyone may create a Member account with this
# storage quota (bytes). Rate-limited per IP and in total, per hour.
SIGNUP_ENABLED=false
SIGNUP_QUOTA_BYTES=2000000000
SIGNUP_MAX_PER_IP_PER_HOUR=3
SIGNUP_MAX_PER_HOUR=20

# ── PostgreSQL ────────────────────────────────────────────────────────
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
POSTGRES_DB=scanova
# Runtime role: data access only (no DDL).
POSTGRES_APP_USER=scanova_app
POSTGRES_APP_PASSWORD=
# Migration role: owns the schema; used only by `prisma migrate`.
POSTGRES_MIGRATOR_USER=scanova_migrator
POSTGRES_MIGRATOR_PASSWORD=
# Superuser password for the container's first start. <generated>
POSTGRES_SUPERUSER_PASSWORD=

# ── PostgreSQL: key database ──────────────────────────────────────────
# Holds wrapped keys ONLY, apart from the data they protect, with its own
# roles: the main roles cannot connect here and these cannot connect to
# the main database. Same instance by default; point host/port elsewhere
# to move the keys to their own PostgreSQL instance or machine.
KEYS_POSTGRES_HOST=127.0.0.1
KEYS_POSTGRES_PORT=55432
KEYS_POSTGRES_DB=scanova_keys
KEYS_POSTGRES_APP_USER=scanova_keys_app
KEYS_POSTGRES_APP_PASSWORD=
KEYS_POSTGRES_MIGRATOR_USER=scanova_keys_migrator
KEYS_POSTGRES_MIGRATOR_PASSWORD=

# ── Object storage (Garage, S3-compatible) — holds ciphertext only ────
# bundled  = Scanova's own Garage container
# external = an S3 service outside this stack (for example a Garage already
#            running on the server). The bucket and key below are then made
#            there, and S3_ENDPOINT_INTERNAL is how the containers reach it.
SCANOVA_S3_MODE=bundled
S3_ENDPOINT_INTERNAL=http://garage:3900
S3_ENDPOINT=http://127.0.0.1:53900
S3_REGION=garage
S3_BUCKET=scanova-documents
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=

# ── Key vault (OpenBao, Transit engine) ───────────────────────────────
BAO_ADDR=https://127.0.0.1:58200
BAO_TRANSIT_MOUNT=transit
# Master keys — never leave the vault. One per user type.
BAO_KEY_UTK_ADMIN=scanova-utk-admin
BAO_KEY_UTK_MEMBER=scanova-utk-member
# Wraps system-level data keys (audit log, e-mail lookup index).
BAO_KEY_SYSTEM=scanova-sys
# Ed25519 key that signs access tokens.
BAO_KEY_JWT=scanova-jwt
# AppRole credentials, least privilege per process. <generated>
BAO_API_ROLE_ID=
BAO_API_SECRET_ID=
BAO_WORKER_ROLE_ID=
BAO_WORKER_SECRET_ID=

# ── Key rotation policy (days) ────────────────────────────────────────
KEY_ROTATION_UTK_DAYS=90
KEY_ROTATION_USER_KEY_DAYS=180
KEY_ROTATION_JWT_DAYS=30
KEY_REWRAP_BATCH_SIZE=200

# ── Worker / OCR ──────────────────────────────────────────────────────
WORKER_OCR_CONCURRENCY=1
OCR_LANGUAGES=eng+urd
# Plaintext scratch space for OCR. MUST be a tmpfs (RAM) mount.
SCANOVA_TMP_DIR=/run/scanova-tmp

# ── AI (milestone 2 — local, off by default; docs/ARCHITECTURE.md §11) ─
# none              = no AI anywhere (every other AI_* value is ignored)
# openai-compatible = any server with the OpenAI chat + embeddings API: the
#                     bundled llama.cpp services (Compose profile `ai`) or
#                     another runtime the operator chooses. Keep `none` until
#                     the evaluation (tools/ai-eval) has picked the models.
AI_PROVIDER=none
# Addresses the worker and the API use inside the Compose network (the AI services
# publish no port, so there is no host-side address). Another runtime: its /v1 URL.
AI_CHAT_BASE_URL=http://ai-chat:8080/v1
AI_EMBED_BASE_URL=http://ai-embed:8080/v1
# Model names: also the names in the llama.cpp routers' presets, set by
# `infra/scripts/ai-models.sh use`. The embedding name must keep its family (qwen3-embedding, e5, …): it
# selects the query/document prefixes the model expects.
AI_CHAT_MODEL=
AI_EMBED_MODEL=
# Stored vector length (Matryoshka truncation), e.g. 256 for qwen3-embedding.
AI_EMBED_DIMENSIONS=
# The runtime refuses every request without it. <generated>
AI_API_KEY=
# No model is in memory until an owner turns AI on in the app (operator CLI
# owner:grant); it is unloaded again 15 minutes after their app was closed
# (§11.8). Before loading, the API checks the server still has this much memory
# free for its other services afterwards; otherwise it refuses.
AI_KEEP_FREE_MB=2048
# llama.cpp services (profile ai). The two memory caps are the AI budget (6 GiB),
# used only while the models are loaded.
AI_CHAT_CONTEXT_SIZE=8192
AI_CHAT_THREADS=8
AI_CHAT_IMAGE_MAX_TOKENS=1120
AI_CHAT_MEMORY_LIMIT=4608m
AI_EMBED_CONTEXT_SIZE=2048
AI_EMBED_THREADS=4
AI_EMBED_MEMORY_LIMIT=1536m
